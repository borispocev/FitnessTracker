@model IEnumerable<FitnessTracker.Domain.Entities.Exercise>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Exercises</h3>
        <div class="muted">Manage Exercises</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Exercise</a>
</div>


<div class="glass p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Exercise Name</th>
                    <th>Description</th>
                    <th>Muscle Group</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.Name</td>
                        <td>@u.Description</td>
                        <td>@u.MuscleGroup</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>