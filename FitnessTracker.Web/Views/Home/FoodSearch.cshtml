@model List<FitnessTracker.Application.Interfaces.FoodSearchResult>

<h2>Food Search Results</h2>

@if (Model.Count == 0)
{
    <p>No results. Try searching something like "yogurt", "chocolate", "bread".</p>
}
else
{
    <table border="1" cellpadding="6">
        <thead>
            <tr>
                <th>Product</th>
                <th>Brand</th>
                <th>Kcal / 100g</th>
                <th>Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Name</td>
                    <td>@r.Brand</td>
                    <td>@r.KcalPer100g</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                        {
                            <img src="@r.ImageUrl" width="60" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a href="/">Back</a>
